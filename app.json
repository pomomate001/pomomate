{
  "expo": {
    "name": "PomoMate – Birlikte Çalış",
    "slug": "pomomate",
    "version": "1.3.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pomomate.app",
      "buildNumber": "10",
      "infoPlist": {
        "NSCameraUsageDescription": "Profil fotoğrafı eklemek için kamera erişimi gerekiyor.",
        "NSMicrophoneUsageDescription": "Sesli görüşme özelliği için mikrofon erişimi gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı seçmek için galeri erişimi gerekiyor.",
        "NSUserNotificationsUsageDescription": "Pomodoro tamamlandığında bildirim göndermek için izin gerekiyor.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "bitcode": false
    },
    "android": {
      "package": "com.pomomate.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pomomate.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#ef4435",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "PomoMate"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Profil fotoğrafı çekmek için kamera izni gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçmek için galeri izni gerekiyor.",
          "cameraPermission": "Profil fotoğrafı çekmek için kamera izni gerekiyor."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1530810645169749~1975999982",
          "iosAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX",
          "userTrackingUsageDescription": "Bu tanımlayıcı, kişiselleştirilmiş reklamlar sunmak için kullanılır.",
          "skAdNetworkItems": []
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli görüşme için mikrofon izni gerekiyor."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Görüntülü çalışma oturumu için kamera izni gerekiyor.",
          "microphonePermission": "Sesli görüşme için mikrofon izni gerekiyor."
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-splash-screen",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "c9c3a47f-7c88-446d-af51-256026508e8a"
      }
    },
    "owner": "pomomate",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c9c3a47f-7c88-446d-af51-256026508e8a"
    },
    "scheme": "pomomate"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-1530810645169749~1975999982",
    "ios_app_id": "ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX"
  }
}
