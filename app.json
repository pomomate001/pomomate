{
  "expo": {
    "name": "PomoMate \u2013 Birlikte \u00c7al\u0131\u015f",
    "slug": "pomomate",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A73E8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pomomate.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Profil foto\u011fraf\u0131 eklemek i\u00e7in kamera eri\u015fimi gerekiyor.",
        "NSMicrophoneUsageDescription": "Sesli g\u00f6r\u00fc\u015fme \u00f6zelli\u011fi i\u00e7in mikrofon eri\u015fimi gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Profil foto\u011fraf\u0131 se\u00e7mek i\u00e7in galeri eri\u015fimi gerekiyor.",
        "NSUserNotificationsUsageDescription": "Pomodoro tamamland\u0131\u011f\u0131nda bildirim g\u00f6ndermek i\u00e7in izin gerekiyor.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.pomomate.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1A73E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pomomate.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#1A73E8",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "PomoMate"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Profil foto\u011fraf\u0131 \u00e7ekmek i\u00e7in kamera izni gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil foto\u011fraf\u0131 se\u00e7mek i\u00e7in galeri izni gerekiyor.",
          "cameraPermission": "Profil foto\u011fraf\u0131 \u00e7ekmek i\u00e7in kamera izni gerekiyor."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1530810645169749~8885949301",
          "iosAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX",
          "userTrackingUsageDescription": "Bu tan\u0131mlay\u0131c\u0131, ki\u015fiselle\u015ftirilmi\u015f reklamlar sunmak i\u00e7in kullan\u0131l\u0131r.",
          "skAdNetworkItems": []
        }
      ],
      "expo-keep-awake",
      "expo-screen-capture",
      [
        "expo-av",
        {
          "microphonePermission": "Sesli g\u00f6r\u00fc\u015fme i\u00e7in mikrofon izni gerekiyor."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c9c3a47f-7c88-446d-af51-256026508e8a"
      }
    },
    "owner": "pomomate",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "pomomate"
  }
}