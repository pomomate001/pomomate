# ============================================================
# PomoMate – Uygulama Ortam Değişkenleri
# ============================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
#
# ÖNEMLİ: .env dosyası asla git'e eklenmemeli (.gitignore'a ekli)
# EAS build için değerleri eas secret:push ile ekleyin.
# ============================================================

# ── Ortam ───────────────────────────────────────────────────
# Değerler: dev | staging | prod
EXPO_PUBLIC_ENV=dev

# ── Backend API ─────────────────────────────────────────────
# PomoMate Express backend URL'si (M03)
# Geliştirme: http://localhost:3000
# Üretim: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Supabase proje ayarlarından alın → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ── WebRTC Signaling ────────────────────────────────────────
# WebSocket sinyal sunucusu URL'si (M04)
# Geliştirme: ws://localhost:3000/ws/signaling
# Üretim: wss://api.yourdomain.com/ws/signaling
EXPO_PUBLIC_WEBRTC_SIGNALING_URL=ws://localhost:3000/ws/signaling

# ── AdMob (Google Mobile Ads) ───────────────────────────────
# NOT: AdMob App ID, app.json içindeki plugin konfigürasyonunda tanımlı.
# Aşağıdaki ID'ler reklam birimi ID'leridir (Ad Unit IDs).
# Google AdMob konsolundan alın: apps.admob.com
#
# Android Banner reklam birimi ID
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# iOS Banner reklam birimi ID
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Test amaçlı sabit test ID'leri (geliştirme ortamında kullanın):
# Android: ca-app-pub-3940256099942544/6300978111
# iOS:     ca-app-pub-3940256099942544/2934735716

# ── RevenueCat ──────────────────────────────────────────────
# RevenueCat konsolundan alın: app.revenuecat.com → Projects → API Keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
