# PomoMate — Environment variables (EXAMPLE)
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.
#
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle.
# Do NOT put server-side secrets (Supabase service_role key, etc.) here.

# Active environment: dev | staging | prod
EXPO_PUBLIC_ENV=dev

# Backend API base URL (M03)
EXPO_PUBLIC_API_URL=https://api.example.com

# Self-hosted Supabase (M03)
EXPO_PUBLIC_SUPABASE_URL=https://supabase.example.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# WebRTC signaling server (M04)
EXPO_PUBLIC_WEBRTC_SIGNALING_URL=wss://signaling.example.com
