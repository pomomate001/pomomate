<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center"
    android:elevation="8dp">

    <ImageButton
        android:id="@+id/btn_mic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_pip_mic_on"
        android:contentDescription="Mikrofon" />

    <ImageButton
        android:id="@+id/btn_cam"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_pip_cam_off"
        android:contentDescription="Kamera" />

    <ImageButton
        android:id="@+id/btn_screen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_pip_screen_off"
        android:contentDescription="Ekran Paylaşımı" />

    <ImageButton
        android:id="@+id/btn_open_app"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_pip_expand"
        android:contentDescription="Uygulamayı Aç" />

    <ImageButton
        android:id="@+id/btn_close_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_pip_close"
        android:contentDescription="Kapat" />
</LinearLayout>

